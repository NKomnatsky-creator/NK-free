# Скопируйте в .env и заполните перед docker compose up
FLASK_SECRET=replace-with-a-long-random-string
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
# Для схемы с TLS-прокси (nginx/passvault.conf.example) оставляем 1:
# cookie получает Secure, а IP-баны видят реальный адрес клиента из X-Forwarded-For.
# При прямом HTTP-доступе к контейнеру задайте HTTPS=0 и TRUSTED_PROXY_COUNT=0.
HTTPS=1
TRUSTED_PROXY_COUNT=1
# Общий секрет app.py и server.py: разрешает доверять полю client_ip,
# если бэкенд слушает не на loopback (например, отдельный контейнер).
# INTERNAL_API_SECRET=replace-with-another-long-random-string

# Онлайн-лицензирование.
# Приложение НЕ хранит подписанную лицензию: хранится только installation.json
# со случайным installation_id и secret (права 0600). Это не файл лицензии.
# Сервер выдачи находится в C:\Project2_0_Server-License
# Запуск: cd C:\Project2_0_Server-License && python license_server.py
# Начальный адрес. Администратор может сменить его в Админка → Тарифы,
# тогда значение сохраняется в DATA_DIR/license_server.conf и имеет приоритет над env.
# LICENSE_SERVER_URL=http://127.0.0.1:8100
# Резервные адреса задаются в админке через запятую (до 4 адресов).
# LICENSE_SERVER_CONFIG=/data/license_server.conf
# LICENSE_PUBLIC_KEY=C:\Project2_0_Server-License\license_server_data\public_key.pem
# ОБЯЗАТЕЛЬНЫЙ общий токен для /api/redeem, /api/validate, /api/probe и /api/import.
# Без него issuing-сервер вернёт 503 для служебных API (fail-closed).
# LICENSE_SERVER_REDEEM_TOKEN=replace-with-a-long-random-string
# Свой CA для самоподписанного HTTPS issuing-сервера:
# LICENSE_CA_BUNDLE=/etc/ssl/certs/license-issuer-ca.pem
# SSRF-защита: пусто = любые адреса кроме метаданных; иначе список IP/CIDR/имен через запятую.
# LICENSE_SERVER_ALLOWED_NETWORKS=10.0.0.0/8,license.internal
# LICENSE_SERVER_DENIED_NETWORKS=169.254.0.0/16,100.64.0.0/10,::ffff:169.254.0.0/104

# Гибридная проверка: старт + кэш, сбой сервера -> кэш 24 ч, отзыв -> сразу Free.
# LICENSE_VALIDATE_TTL=600          # секунд между проверками (5–10 минут)
# LICENSE_VALIDATE_RETRY=30         # как часто повторять после сбоя
# LICENSE_VALIDATE_TIMEOUT=3        # таймаут HTTP-запроса, секунд
# LICENSE_OFFLINE_GRACE=86400       # сколько секунд жить без сервера (24 ч)
# INSTALLATION_FILE=/data/installation.json

# LICENSE_KEY нужен только для одноразовой миграции старых подписанных лицензий.
# Короткий код в LICENSE_KEY не принимается — активируйте его в админке.
# LICENSE_KEY=NK1-XXXXXXXX.XXXXXXXX.XXXXXXXX
